    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@tsconfig/svelte": "^5.0.2",
    "@types/bun": "^1.4.0",
    "@types/prismjs": "^1.26.6",
    "autoprefixer": "^10.4.18",
    "eslint": "^10.9.1",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.4.35",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "3",
    "svelte": "^4.2.12",
    "svelte-check": "^3.6.6",
    "tailwindcss": "^3.4.1",
    "tslib": "^2.6.2",
    "typescript": "^5.4.2",
